{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yachiyo-relay-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_SESSION",
        "class_name": "RelaySession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelaySession"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
