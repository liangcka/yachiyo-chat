{
  "name": "yachiyo-chat",
  "version": "0.1.0",
  "description": "Mobile-first PWA for roleplay chat with Tsukimi Yachiyo, featuring starfield glass UI, multi-provider LLM support, web search, and offline capabilities.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/liangcka/yachiyo-chat.git"
  },
  "type": "module",
  "scripts": {
    "sync:prompt": "node scripts/sync-role-prompt.mjs",
    "prebuild": "npm run sync:prompt && node scripts/clean-build-output.mjs",
    "pretypecheck": "npm run sync:prompt",
    "pretest:functions": "npm run sync:prompt",
    "dev": "vite --configLoader runner",
    "dev:pages": "npm run build && wrangler pages dev dist --kv RATE_LIMIT_KV",
    "dev:mock": "npm run build && wrangler pages dev dist --kv RATE_LIMIT_KV --binding APP_MODE=mock",
    "build": "npm run typecheck && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false && tsc --noEmit -p functions/tsconfig.json --pretty false",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:functions",
    "test:unit": "vitest run --configLoader runner --config vitest.config.ts",
    "test:functions": "vitest run --configLoader runner --config vitest.functions.config.ts",
    "test:e2e": "playwright test",
    "test:perf": "npm run build && playwright test --config playwright.perf.config.ts",
    "mob:sync": "npm run build && cap sync android",
    "mob:build": "npm run mob:sync && cd android && gradlew.bat assembleRelease",
    "relay:dev": "npm --prefix relay-worker run dev",
    "relay:deploy": "npm --prefix relay-worker run deploy",
    "cf:types": "wrangler types --path=./types/runtime-types.d.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@tanstack/react-virtual": "^3.14.10",
    "dexie": "^4.4.4",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.110.0"
  }
}
