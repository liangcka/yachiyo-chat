{
  "name": "yachiyo-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:prompt": "node scripts/sync-role-prompt.mjs",
    "prebuild": "npm run sync:prompt && node scripts/clean-build-output.mjs",
    "pretypecheck": "npm run sync:prompt",
    "pretest:functions": "npm run sync:prompt",
    "dev": "vite --configLoader runner",
    "dev:pages": "npm run build && wrangler pages dev dist --kv RATE_LIMIT_KV",
    "dev:mock": "npm run build && wrangler pages dev dist --kv RATE_LIMIT_KV --binding APP_MODE=mock",
    "build": "npm run typecheck && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false && tsc --noEmit -p functions/tsconfig.json --pretty false",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:functions",
    "test:unit": "vitest run --configLoader runner --config vitest.config.ts",
    "test:functions": "vitest run --configLoader runner --config vitest.functions.config.ts",
    "test:e2e": "playwright test",
    "cf:types": "wrangler types --path=./types/runtime-types.d.ts"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.110.0"
  }
}
